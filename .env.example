# =============================================================================
# GenBI Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env files — this .env.example is the canonical template
# =============================================================================

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_REASONING_MODEL=claude-opus-4
LLM_FAST_MODEL=claude-haiku-4

# --- Database (asyncpg format) ---
# Runtime role: non-superuser, RLS-bound (see docs/adr/006-enforced-rls-roles.md).
# Owner credentials (Alembic, admin scripts) stay in DATABASE_URL_SYNC.
DATABASE_URL=postgresql+asyncpg://genbi_app:genbi_app@localhost:5432/genbi
# Login-only role (reads `users` across tenants). Leave blank to derive from
# DATABASE_URL with genbi_auth credentials.
DATABASE_URL_AUTH=
# Owner/superuser — migrations and admin scripts ONLY, never the app runtime.
DATABASE_URL_SYNC=postgresql://genbi:genbi@localhost:5432/genbi

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Semantic Layer ---
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_SECRET=change-me-in-production

# --- Observability ---
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Auth ---
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Tenant ---
TENANT_ENCRYPTION_KEY=change-me-in-production-use-fernet-generate-key

# --- Flint Chart (MCP) ---
FLINT_MCP_BACKENDS=vegalite,echarts,chartjs
FLINT_MCP_DATA_ROOTS=/tmp/genbi-charts

# --- App ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000
