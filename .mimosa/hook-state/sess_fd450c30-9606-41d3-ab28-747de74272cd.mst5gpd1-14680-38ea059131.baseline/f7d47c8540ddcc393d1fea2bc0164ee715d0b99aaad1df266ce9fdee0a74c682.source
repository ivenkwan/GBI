"""Cube.dev semantic layer client.

Connects GenBI's agent pipeline to the Cube.dev metrics API, the single
source of truth for all business metric definitions. Every metric-aware
feature in GenBI routes through this client:

- NL2SQLAgent: resolves metric names to underlying SQL dimensions/measures
- ChartGenAgent: retrieves metric metadata for axis label formatting
- API routes (/api/v1/metrics): lists metrics and executes metric queries

Cube.dev exposes two primary APIs:
- REST API (legacy): POST /cubejs-api/v1/load for queries, /meta for schema
- GraphQL API (v2): richer query semantics, recommended path

This client uses the REST API for maximum compatibility and adds GraphQL
support as an optional upgrade path.

Architecture:
    Agent Pipeline → CubeClient.get_metric("revenue_total")
      → Cache check (Redis, TTL 5min)
        → Cache miss: HTTP POST to Cube REST API
          → Cache hit: return cached definition
            → Format for LLM context injection

Metrics are NEVER re-implemented in agent code — always query via this client.
"""

import contextlib
import json
from dataclasses import dataclass, field
from datetime import UTC, datetime
from enum import StrEnum
from typing import Any

import httpx

from app.core.config import settings
from app.core.logging import logger

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------


class MetricType(StrEnum):
    """Cube.dev metric types mapped from dbt MetricFlow."""

    SUM = "sum"
    COUNT = "count"
    COUNT_DISTINCT = "count_distinct"
    AVG = "avg"
    MIN = "min"
    MAX = "max"
    RATIO = "ratio"
    DERIVED = "derived"
    RUNNING_TOTAL = "running_total"


class DimensionType(StrEnum):
    """Cube.dev dimension types."""

    STRING = "string"
    NUMBER = "number"
    TIME = "time"
    BOOLEAN = "boolean"
    GEO = "geo"


@dataclass
class MetricDefinition:
    """Resolved metric definition from Cube.dev meta API.

    These are injected into agent prompts as structured context
    so the LLM knows what metrics are available and how to use them.
    """

    name: str
    title: str
    description: str
    metric_type: MetricType
    # The underlying Cube measure/dimension this metric references
    cube_name: str
    measure_name: str
    # Dimensions available for grouping with this metric
    dimensions: list[str] = field(default_factory=list)
    # Time dimensions for time-series queries
    time_dimensions: list[str] = field(default_factory=list)
    # Format metadata (currency, percent, decimal places)
    format: dict | None = None


@dataclass
class MetricQueryResult:
    """Result of executing a metric query against Cube.dev."""

    metric_name: str
    query: dict  # The Cube query that was sent
    data: list[dict]  # Flattened result rows
    annotation: dict  # Cube annotation metadata (formatting, types)
    total: float | None = None
    cached: bool = False
    query_latency_ms: float = 0


@dataclass
class CubeMetaResponse:
    """Parsed response from Cube.dev /meta endpoint."""

    cubes: list[dict] = field(default_factory=list)
    metrics: dict[str, MetricDefinition] = field(default_factory=dict)
    raw: dict = field(default_factory=dict)


# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------


class CubeClient:
    """Async HTTP client for Cube.dev REST API.

    Usage:
        client = CubeClient()

        # List all metrics (useful for autocomplete and context injection)
        metrics = await client.list_metrics()
        # → {"revenue_total": MetricDefinition(...), ...}

        # Resolve a single metric's definition
        metric = await client.get_metric("revenue_total")

        # Execute a metric query with dimensional breakdown
        result = await client.query(
            metrics=["revenue_total"],
            dimensions=["region"],
            time_dimensions=[{"dimension": "transaction_date", "granularity": "month"}],
            filters=[{"member": "region", "operator": "equals", "values": ["North"]}],
        )

        # Format metric definitions for LLM prompt context
        context = client.format_metrics_for_llm(metrics)
        # → "**revenue_total**: Sum of all recognized revenue (sum of revenue_amount)"

        # Health check — verify Cube is reachable
        ok = await client.health_check()
    """

    def __init__(
        self,
        api_url: str | None = None,
        api_secret: str | None = None,
        cache_ttl_seconds: int = 300,
    ):
        """Initialize the Cube client.

        Args:
            api_url: Cube REST API URL. Defaults to settings.CUBE_API_URL.
            api_secret: Cube API secret for JWT auth. Defaults to settings.CUBE_API_SECRET.
            cache_ttl_seconds: How long to cache metric definitions (default 5 min).
        """
        self.api_url = (api_url or settings.CUBE_API_URL).rstrip("/")
        self.api_secret = api_secret or settings.CUBE_API_SECRET
        self.cache_ttl = cache_ttl_seconds

        # In-memory cache for metric definitions
        self._metric_cache: dict[str, tuple[MetricDefinition, float]] = {}
        self._meta_cache: tuple[CubeMetaResponse, float] | None = None

        # Redis cache (if available)
        self._redis = None
        self._redis_available = False

    async def _ensure_redis(self) -> None:
        """Lazy-init Redis connection."""
        if self._redis is not None:
            return

        try:
            import redis.asyncio as aioredis

            self._redis = aioredis.from_url(
                settings.REDIS_URL,
                decode_responses=False,
                socket_connect_timeout=3,
            )
            await self._redis.ping()
            self._redis_available = True
            logger.info("CubeClient: Redis cache connected")
        except Exception as e:
            logger.warning(f"CubeClient: Redis unavailable, using in-memory cache only — {e}")
            self._redis = None
            self._redis_available = False

    # ------------------------------------------------------------------
    # HTTP transport
    # ------------------------------------------------------------------

    async def _request(self, path: str, method: str = "GET", json_body: dict | None = None) -> dict:
        """Make an authenticated HTTP request to Cube.dev.

        Cube uses JWT authentication: Authorization: <token>
        The token is the api_secret itself (HS256 JWT) or a pre-generated token.

        Args:
            path: API path relative to api_url (e.g. "/meta", "/load").
            method: HTTP method.
            json_body: Request body for POST requests.

        Returns:
            Parsed JSON response body.

        Raises:
            httpx.HTTPError: On HTTP errors.
            ConnectionError: If Cube is unreachable.
        """
        url = f"{self.api_url}/{path.lstrip('/')}"

        headers: dict[str, str] = {
            "Content-Type": "application/json",
        }
        if self.api_secret:
            headers["Authorization"] = self.api_secret

        async with httpx.AsyncClient(timeout=30.0) as client:
            if method == "GET":
                response = await client.get(url, headers=headers)
            else:
                response = await client.post(url, headers=headers, json=json_body)

            response.raise_for_status()
            return response.json()

    # ------------------------------------------------------------------
    # Meta API — schema discovery
    # ------------------------------------------------------------------

    async def get_meta(self, force_refresh: bool = False) -> CubeMetaResponse:
        """Fetch the full Cube metadata schema (/meta endpoint).

        The meta response includes all cubes, measures, dimensions,
        segments, and pre-aggregations — everything needed to build
        metric definitions for LLM context.

        Results are cached in Redis (TTL: cache_ttl) and in-memory.

        Args:
            force_refresh: If True, bypass cache and re-fetch.

        Returns:
            Parsed CubeMetaResponse with cubes list and metric definitions map.
        """
        # Check cache
        if not force_refresh:
            cached = await self._get_cached("cube:meta")
            if cached is not None:
                logger.debug("CubeClient: meta cache hit")
                return CubeMetaResponse(**cached) if isinstance(cached, dict) else cached

            if self._meta_cache is not None:
                meta, cached_at = self._meta_cache
                age = datetime.now(UTC).timestamp() - cached_at
                if age < self.cache_ttl:
                    return meta

        logger.info("CubeClient: fetching meta from Cube API")
        raw = await self._request("/meta")

        # Parse cubes
        meta = self._parse_meta(raw)

        # Cache
        await self._set_cached("cube:meta", meta)
        self._meta_cache = (meta, datetime.now(UTC).timestamp())

        return meta

    def _parse_meta(self, raw: dict) -> CubeMetaResponse:
        """Parse Cube /meta response into structured form.

        Cube's meta response format:
        {
            "cubes": [
                {
                    "name": "revenue",
                    "title": "Revenue",
                    "measures": [{"name": "revenue_amount", "title": "Revenue Amount", ...}],
                    "dimensions": [{"name": "region", "title": "Region", "type": "string"}, ...],
                    "segments": [...]
                }
            ]
        }
        """
        cubes = raw.get("cubes", [])
        metrics: dict[str, MetricDefinition] = {}

        for cube in cubes:
            cube_name = cube.get("name", "")

            # Measures → MetricDefinitions
            for measure in cube.get("measures", []):
                measure_name = measure.get("name", "")
                # Build metric key: cube.measure or just measure
                key = f"{cube_name}.{measure_name}"

                metric = MetricDefinition(
                    name=key,
                    title=measure.get("title", measure_name),
                    description=measure.get("description", ""),
                    metric_type=self._infer_metric_type(measure.get("type", "sum")),
                    cube_name=cube_name,
                    measure_name=measure_name,
                    dimensions=[
                        d.get("name", "")
                        for d in cube.get("dimensions", [])
                        if d.get("type") != "time"
                    ],
                    time_dimensions=[
                        d.get("name", "")
                        for d in cube.get("dimensions", [])
                        if d.get("type") == "time"
                    ],
                    format=measure.get("format"),
                )

                # Also index by just the measure name for convenience
                metrics[key] = metric
                if measure_name not in metrics:
                    metrics[measure_name] = metric

        return CubeMetaResponse(cubes=cubes, metrics=metrics, raw=raw)

    def _infer_metric_type(self, cube_type: str) -> MetricType:
        """Map Cube measure types to MetricType enum."""
        type_map = {
            "sum": MetricType.SUM,
            "count": MetricType.COUNT,
            "countDistinct": MetricType.COUNT_DISTINCT,
            "countDistinctApprox": MetricType.COUNT_DISTINCT,
            "avg": MetricType.AVG,
            "min": MetricType.MIN,
            "max": MetricType.MAX,
            "number": MetricType.SUM,
            "runningTotal": MetricType.RUNNING_TOTAL,
        }
        return type_map.get(cube_type, MetricType.SUM)

    # ------------------------------------------------------------------
    # Metric resolution
    # ------------------------------------------------------------------

    async def list_metrics(self, force_refresh: bool = False) -> dict[str, MetricDefinition]:
        """List all available metrics from the semantic layer.

        Use this to populate the LLM context with available metrics,
        drive the frontend metric picker, and support autocomplete.

        Returns:
            Dict mapping metric name → MetricDefinition.
        """
        meta = await self.get_meta(force_refresh=force_refresh)
        return meta.metrics

    async def get_metric(self, name: str) -> MetricDefinition | None:
        """Resolve a single metric by name.

        Args:
            name: Metric name (e.g. "revenue_total", "revenue.revenue_amount").

        Returns:
            MetricDefinition or None if not found.
        """
        # Check cache
        cache_key = f"cube:metric:{name}"
        cached = await self._get_cached(cache_key)
        if cached is not None:
            return MetricDefinition(**cached) if isinstance(cached, dict) else cached

        # Check in-memory cache
        if name in self._metric_cache:
            metric, cached_at = self._metric_cache[name]
            age = datetime.now(UTC).timestamp() - cached_at
            if age < self.cache_ttl:
                return metric

        # Fetch
        metrics = await self.list_metrics()
        metric = metrics.get(name)

        if metric:
            self._metric_cache[name] = (metric, datetime.now(UTC).timestamp())
            await self._set_cached(cache_key, metric)

        return metric

    # ------------------------------------------------------------------
    # Metric queries
    # ------------------------------------------------------------------

    async def query(
        self,
        metrics: list[str],
        dimensions: list[str] | None = None,
        time_dimensions: list[dict] | None = None,
        filters: list[dict] | None = None,
        order: list[list[str]] | None = None,
        limit: int = 1000,
        offset: int = 0,
        timezone: str = "UTC",
    ) -> MetricQueryResult:
        """Execute a metric query against Cube.dev.

        Args:
            metrics: List of metric names to compute.
            dimensions: Optional list of dimension names to group by.
            time_dimensions: Optional list of time dimension specs:
                [{"dimension": "transaction_date", "granularity": "month", "dateRange": ["2026-01-01", "2026-06-30"]}]
            filters: Optional list of filter specs:
                [{"member": "region", "operator": "equals", "values": ["North"]}]
            order: Sort order: [["revenue_total", "desc"]].
            limit: Max rows.
            offset: Pagination offset.
            timezone: Timezone for time dimension calculations.

        Returns:
            MetricQueryResult with flattened data and metadata.
        """
        import time

        start_time = time.time()

        # Build the Cube query
        cube_query: dict[str, Any] = {
            "measures": metrics,
            "limit": limit,
            "offset": offset,
            "timezone": timezone,
        }

        if dimensions:
            cube_query["dimensions"] = dimensions

        if time_dimensions:
            cube_query["timeDimensions"] = time_dimensions

        if filters:
            cube_query["filters"] = filters

        if order:
            cube_query["order"] = {order_item[0]: order_item[1] for order_item in order}

        logger.info(
            "CubeClient: executing metric query",
            metrics=metrics,
            dimensions=dimensions,
        )

        try:
            raw = await self._request("/load", method="POST", json_body={"query": cube_query})

            # Cube /load response:
            # {
            #   "query": {...},
            #   "data": [{"revenue.revenue_amount": 120000, "revenue.region": "North"}, ...],
            #   "annotation": {"measures": {...}, "dimensions": {...}, ...}
            # }

            data = raw.get("data", [])
            annotation = raw.get("annotation", {})

            # Flatten data: strip cube prefixes from keys
            flat_data = []
            for row in data:
                flat_row = {}
                for key, value in row.items():
                    # "revenue.revenue_amount" → "revenue_amount"
                    short_key = key.split(".", 1)[-1] if "." in key else key
                    flat_row[short_key] = value
                flat_data.append(flat_row)

            # Compute total if a single metric
            total = None
            if len(metrics) == 1 and data:
                metric_key = metrics[0].replace(".", ".")
                with contextlib.suppress(ValueError, TypeError):
                    total = sum(
                        float(row.get(metric_key, 0))
                        for row in data
                        if row.get(metric_key) is not None
                    )

            latency = (time.time() - start_time) * 1000

            return MetricQueryResult(
                metric_name=metrics[0] if len(metrics) == 1 else "multi",
                query=cube_query,
                data=flat_data,
                annotation=annotation,
                total=total,
                cached=False,
                query_latency_ms=latency,
            )

        except httpx.HTTPStatusError as e:
            logger.error(f"Cube query failed ({e.response.status_code}): {e.response.text}")
            raise
        except Exception:
            logger.exception("Cube query failed with unexpected error")
            raise

    # ------------------------------------------------------------------
    # LLM context formatting
    # ------------------------------------------------------------------

    def format_metrics_for_llm(
        self,
        metrics: dict[str, MetricDefinition] | None = None,
        metric_names: list[str] | None = None,
    ) -> str:
        """Format metric definitions for injection into LLM system prompts.

        Produces a compact, readable summary of available metrics that
        can be injected into the NL2SQL agent's user message.

        Args:
            metrics: Pre-fetched metrics dict. If None, loads from cache.
            metric_names: If provided, filter to only these metrics.

        Returns:
            Formatted string suitable for LLM context injection.
        """
        # Build the list
        if metric_names and metrics:
            selected = {name: metrics[name] for name in metric_names if name in metrics}
        else:
            selected = metrics or {}

        if not selected:
            return "No metrics available from the semantic layer."

        lines = ["## Available Metrics (from Semantic Layer)\n"]

        for name, metric in sorted(selected.items()):
            type_label = metric.metric_type.value
            dims = ", ".join(metric.dimensions[:5]) if metric.dimensions else "none"
            time_dims = ", ".join(metric.time_dimensions[:3]) if metric.time_dimensions else "none"

            lines.append(f"- **{name}** ({type_label})")
            if metric.description:
                lines.append(f"  {metric.description}")
            lines.append(f"  Cube: {metric.cube_name}, Measure: {metric.measure_name}")
            if metric.dimensions:
                lines.append(f"  Dimensions: {dims}")
            if metric.time_dimensions:
                lines.append(f"  Time dimensions: {time_dims}")
            lines.append("")  # blank line between metrics

        lines.append(
            "\nTo query these metrics, use the Cube API. "
            "Measures should be referenced as `{cube}.{measure}` "
            "(e.g. `revenue.revenue_amount`) in Cube queries."
        )

        return "\n".join(lines)

    def format_metric_for_prompt(self, name: str, metric: MetricDefinition) -> str:
        """Format a single metric definition as a compact prompt line."""
        parts = [f"**{name}**: {metric.description or metric.title}"]
        parts.append(f"(type: {metric.metric_type.value}, cube: {metric.cube_name})")
        if metric.dimensions:
            parts.append(f"— group by: {', '.join(metric.dimensions[:5])}")
        if metric.format:
            fmt = metric.format
            if fmt.get("currency"):
                parts.append(f"— format: currency ({fmt['currency']})")
            elif fmt.get("percent"):
                parts.append("— format: percent")
        return " ".join(parts)

    # ------------------------------------------------------------------
    # Health check
    # ------------------------------------------------------------------

    async def health_check(self) -> bool:
        """Verify Cube.dev is reachable and healthy.

        Returns:
            True if Cube responds to /meta within the timeout.
        """
        try:
            await self._request("/meta")
            return True
        except Exception as e:
            logger.warning(f"CubeClient health check failed: {e}")
            return False

    # ------------------------------------------------------------------
    # Redis cache
    # ------------------------------------------------------------------

    async def _get_cached(self, key: str) -> Any | None:
        """Get a value from Redis cache."""
        if not self._redis_available:
            return None

        try:
            await self._ensure_redis()
            if self._redis:
                raw = await self._redis.get(f"genbi:{key}")
                if raw:
                    # Support both JSON strings and bytes
                    data = json.loads(raw if isinstance(raw, (str, bytes)) else raw.decode("utf-8"))
                    # If this is a MetricDefinition, reconstruct it
                    if isinstance(data, dict) and "metric_type" in data:
                        data["metric_type"] = MetricType(data["metric_type"])
                        return MetricDefinition(**data)
                    return data
        except Exception:
            pass

        return None

    async def _set_cached(self, key: str, value: Any) -> None:
        """Set a value in Redis cache with TTL."""
        if not self._redis_available:
            return

        try:
            await self._ensure_redis()
            if self._redis:
                # Serialize dataclass to dict
                if isinstance(value, MetricDefinition):
                    data = {
                        "name": value.name,
                        "title": value.title,
                        "description": value.description,
                        "metric_type": value.metric_type.value,
                        "cube_name": value.cube_name,
                        "measure_name": value.measure_name,
                        "dimensions": value.dimensions,
                        "time_dimensions": value.time_dimensions,
                        "format": value.format,
                    }
                elif isinstance(value, CubeMetaResponse):
                    data = {
                        "cubes": value.cubes,
                        "raw": value.raw,
                    }
                else:
                    data = value

                await self._redis.setex(
                    f"genbi:{key}",
                    self.cache_ttl,
                    json.dumps(data, default=str),
                )
        except Exception as e:
            logger.debug(f"CubeClient: cache set failed — {e}")

    # ------------------------------------------------------------------
    # Convenience: load metrics for agent context
    # ------------------------------------------------------------------

    async def get_agent_context(
        self,
        query: str | None = None,
        metric_names: list[str] | None = None,
    ) -> str:
        """Convenience method: fetch and format metrics for agent prompt injection.

        This is the primary integration point between the semantic layer
        and the agent pipeline. Called by ChatService before NL2SQLAgent runs.

        Args:
            query: The user's query (used to filter relevant metrics — future enhancement).
            metric_names: Specific metrics to include. If None, includes all.

        Returns:
            Formatted string ready for insertion into the LLM user message.
        """
        metrics = await self.list_metrics()

        if metric_names:
            # Only include requested metrics
            return self.format_metrics_for_llm(metrics=metrics, metric_names=metric_names)

        # TODO: Semantic search over metrics using the query text
        # For now, return all metrics (typically < 50, well within token budget)
        if len(metrics) > 20:
            # If many metrics, return a summary
            return self.format_metrics_for_llm(metrics=metrics)

        return self.format_metrics_for_llm(metrics=metrics)

    # ------------------------------------------------------------------
    # Cleanup
    # ------------------------------------------------------------------

    async def close(self) -> None:
        """Close Redis connection if open."""
        if self._redis:
            with contextlib.suppress(Exception):
                await self._redis.close()
            self._redis = None
            self._redis_available = False


# ---------------------------------------------------------------------------
# Singleton
# ---------------------------------------------------------------------------

_cube_client: CubeClient | None = None


def get_cube_client() -> CubeClient:
    """Get or create the singleton CubeClient instance."""
    global _cube_client
    if _cube_client is None:
        _cube_client = CubeClient()
    return _cube_client
