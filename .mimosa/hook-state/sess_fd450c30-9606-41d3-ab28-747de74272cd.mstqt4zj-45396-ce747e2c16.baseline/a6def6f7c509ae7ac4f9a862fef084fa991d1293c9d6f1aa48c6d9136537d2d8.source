"""vis-flint protocol handler — extends the GPT-Vis protocol for Flint charts.

DB-GPT's GPT-Vis protocol uses markdown code blocks with language identifiers
like ```vis-dashboard``` and ```vis_chart``` that the frontend dispatches to
AntV G2 components.

This module extends that protocol with a new ```vis-flint``` block type that
routes to Flint MCP for rendering. The frontend can embed the resulting
PNG/SVG alongside interactive G2 charts.

Usage in agent response:
    ```vis-flint
    {
      "chartType": "Bar Chart",
      "encodings": {
        "x": {"field": "region"},
        "y": {"field": "revenue"}
      },
      "data": {
        "values": [...]
      }
    }
    ```

The backend chat pipeline detects these blocks, renders them via Flint,
and replaces them with inline base64 images or SVG markup.
"""

import re
from dataclasses import dataclass


@dataclass
class VisFlintBlock:
    """Parsed vis-flint code block from an agent response."""

    raw_json: str
    spec: dict
    start_pos: int
    end_pos: int


def parse_vis_flint_blocks(text: str) -> list[VisFlintBlock]:
    """Extract all ```vis-flint``` code blocks from agent output text.

    Returns a list of parsed blocks with their positions in the original text,
    so the caller can replace them with rendered chart content.
    """
    import json

    pattern = re.compile(r"```vis-flint\n(.*?)```", re.DOTALL)
    blocks = []

    for match in pattern.finditer(text):
        raw = match.group(1).strip()
        try:
            spec = json.loads(raw)
        except json.JSONDecodeError:
            spec = {"error": "Invalid JSON in vis-flint block"}
        blocks.append(
            VisFlintBlock(
                raw_json=raw,
                spec=spec,
                start_pos=match.start(),
                end_pos=match.end(),
            )
        )

    return blocks


async def render_vis_flint_blocks(text: str, tenant_id: str = "default") -> str:
    """Process a response text, rendering all vis-flint blocks to inline charts.

    Each ```vis-flint``` block is replaced with:
    - An inline SVG (for SVG output) or
    - A markdown image with base64 data URI (for PNG output)

    Args:
        text: The raw agent response text containing vis-flint blocks
        tenant_id: Tenant identifier for data isolation

    Returns:
        The same text with vis-flint blocks replaced by rendered chart content
    """
    from app.agents.chart.flint_bridge import FlintChartBridge

    blocks = parse_vis_flint_blocks(text)
    if not blocks:
        return text

    bridge = FlintChartBridge(tenant_id=tenant_id)
    result_parts = []
    last_end = 0

    for block in blocks:
        # Keep text before this block
        result_parts.append(text[last_end : block.start_pos])

        if "error" in block.spec:
            result_parts.append(f"```vis-flint (parse error)\n{block.raw_json}\n```")
        else:
            render_result = await bridge.render(block.spec, backend="vegalite", output_format="svg")

            if render_result.get("svg"):
                # Embed SVG directly — works in most markdown renderers
                result_parts.append(f'<div class="vis-flint-chart">{render_result["svg"]}</div>')
            elif render_result.get("image_base64"):
                # Embed PNG as data URI
                result_parts.append(
                    f'<img src="data:image/png;base64,{render_result["image_base64"]}" '
                    f'alt="{block.spec.get("chartType", "Chart")}" '
                    f'class="vis-flint-chart" />'
                )
            else:
                # Render failed — keep original block with error annotation
                result_parts.append(f"```vis-flint (render failed)\n{block.raw_json}\n```")

        last_end = block.end_pos

    # Append remaining text after last block
    result_parts.append(text[last_end:])

    return "".join(result_parts)
