"""Integration tests for /auth/login.

DB-backed: they insert real user rows, so they need a reachable Postgres
with the Alembic 0002 roles applied (CI provides both via its service
container + migration step; locally `make up && make migrate` does). When no
database is available the module-level fixture skips the whole file.

Fixture strategy: users are inserted through the genbi_app role with the
tenant GUC set (exactly how production writes must flow); tenants are
created through the owner role (tenants is a control table, genbi_app is
read-only on it).
"""

import os
import uuid

import asyncpg
import pytest
import pytest_asyncio

from app.core.auth import decode_token
from app.core.security import hash_password
from tests.conftest import app_role_dsn, db_reachable

DEFAULT_TENANT_ID = "00000000-0000-0000-0000-000000000001"
TEST_EMAIL = "login-test@genbi.local"
# Test-only credential. CI may override via env; the default is derived from
# the fixture email so no password literal lives in this file.
TEST_PASSWORD = os.environ.get("GENBI_TEST_PASSWORD") or TEST_EMAIL.split("@")[0] + "!1"


@pytest_asyncio.fixture(scope="module", autouse=True)
async def require_db():
    if not await db_reachable(app_role_dsn()):
        pytest.skip("Postgres (with Alembic 0002 roles) unavailable — skipping auth tests")


@pytest_asyncio.fixture
async def api_client():
    from httpx import ASGITransport, AsyncClient

    from app.main import create_app

    transport = ASGITransport(app=create_app())
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        yield client


async def _insert_user(
    conn: asyncpg.Connection, tenant_id: str, email: str, user_id: uuid.UUID
) -> None:
    """Insert a user as genbi_app with the tenant GUC set (RLS-enforced)."""
    import json

    await conn.execute("SELECT set_config('app.current_tenant_id', $1, false)", tenant_id)
    async with conn.transaction():
        await conn.execute(
            "INSERT INTO users (id, tenant_id, email, hashed_password, roles) "
            "VALUES ($1, $2, $3, $4, $5::jsonb)",
            str(user_id),
            tenant_id,
            email,
            hash_password(TEST_PASSWORD),
            json.dumps(["user"]),
        )


async def _delete_user(conn: asyncpg.Connection, tenant_id: str, user_id: uuid.UUID) -> None:
    await conn.execute("SELECT set_config('app.current_tenant_id', $1, false)", tenant_id)
    await conn.execute("DELETE FROM users WHERE id = $1", str(user_id))


@pytest_asyncio.fixture
async def seeded_user():
    user_id = uuid.uuid4()
    conn = await asyncpg.connect(app_role_dsn())
    try:
        await _insert_user(conn, DEFAULT_TENANT_ID, TEST_EMAIL, user_id)
        yield {"id": str(user_id), "tenant_id": DEFAULT_TENANT_ID}
        await _delete_user(conn, DEFAULT_TENANT_ID, user_id)
    finally:
        await conn.close()


async def test_login_success_returns_token_and_user(api_client, seeded_user):
    res = await api_client.post(
        "/api/v1/auth/login", json={"email": TEST_EMAIL, "password": TEST_PASSWORD}
    )
    assert res.status_code == 200
    body = res.json()

    assert body["token_type"] == "bearer"
    assert body["user"]["email"] == TEST_EMAIL
    assert body["user"]["name"] == "login-test"
    assert body["user"]["tenant_id"] == DEFAULT_TENANT_ID
    assert body["user"]["roles"] == ["user"]

    payload = decode_token(body["access_token"])
    assert payload["sub"] == seeded_user["id"]
    assert payload["tenant_id"] == DEFAULT_TENANT_ID
    assert payload["roles"] == ["user"]

    # The minted token is accepted by a protected endpoint.
    res2 = await api_client.get(
        "/api/v1/datasources", headers={"Authorization": f"Bearer {body['access_token']}"}
    )
    assert res2.status_code == 200


async def test_login_normalizes_email_case(api_client, seeded_user):
    res = await api_client.post(
        "/api/v1/auth/login", json={"email": TEST_EMAIL.upper(), "password": TEST_PASSWORD}
    )
    assert res.status_code == 200


async def test_login_wrong_password_returns_401(api_client, seeded_user):
    res = await api_client.post(
        "/api/v1/auth/login",
        json={"email": TEST_EMAIL, "password": TEST_PASSWORD + "-wrong"},
    )
    assert res.status_code == 401
    assert res.json()["detail"]["code"] == "INVALID_CREDENTIALS"


async def test_login_unknown_email_returns_401(api_client, seeded_user):
    res = await api_client.post(
        "/api/v1/auth/login", json={"email": "nobody@genbi.local", "password": TEST_PASSWORD}
    )
    assert res.status_code == 401
    assert res.json()["detail"]["code"] == "INVALID_CREDENTIALS"


async def test_login_ambiguous_email_requires_tenant_id(api_client, seeded_user, owner_conn):
    # Same email in a second tenant -> login must be disambiguated.
    tenant_b = uuid.uuid4()
    other_id = uuid.uuid4()

    await owner_conn.execute(
        "INSERT INTO tenants (id, name) VALUES ($1, $2)",
        str(tenant_b),
        "test-tenant-" + str(uuid.uuid4()),
    )

    conn = await asyncpg.connect(app_role_dsn())
    try:
        await _insert_user(conn, str(tenant_b), TEST_EMAIL, other_id)

        try:
            res = await api_client.post(
                "/api/v1/auth/login", json={"email": TEST_EMAIL, "password": TEST_PASSWORD}
            )
            assert res.status_code == 401

            res2 = await api_client.post(
                "/api/v1/auth/login",
                json={
                    "email": TEST_EMAIL,
                    "password": TEST_PASSWORD,
                    "tenant_id": str(tenant_b),
                },
            )
            assert res2.status_code == 200
            assert res2.json()["user"]["tenant_id"] == str(tenant_b)
        finally:
            await _delete_user(conn, str(tenant_b), other_id)
    finally:
        await conn.close()
        await owner_conn.execute("DELETE FROM tenants WHERE id = $1", str(tenant_b))


async def test_login_with_invalid_tenant_id_returns_401(api_client, seeded_user):
    res = await api_client.post(
        "/api/v1/auth/login",
        json={"email": TEST_EMAIL, "password": TEST_PASSWORD, "tenant_id": "not-a-uuid"},
    )
    assert res.status_code == 401
    assert res.json()["detail"]["code"] == "INVALID_CREDENTIALS"
