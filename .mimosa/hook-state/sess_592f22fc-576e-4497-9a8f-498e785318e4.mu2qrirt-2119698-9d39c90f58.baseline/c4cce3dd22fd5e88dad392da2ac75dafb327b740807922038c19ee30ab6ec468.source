"""Flint Chart integration module for GenBI.

This module bridges GenBI's agent pipeline to Microsoft Flint Chart MCP,
providing chart rendering via a unified ChartAssemblyInput spec that compiles
to Vega-Lite, ECharts, or Chart.js.

Architecture:
    GenBI Agent Pipeline
        → ChartGenAgent produces ChartAssemblyInput spec
            → FlintChartBridge (this module) calls Flint MCP
                → Flint MCP server compiles & renders locally
                    → Returns PNG/SVG inline

The bridge also supports:
- AWEL operator integration (FlintChartOperator for workflow canvas)
- vis-flint protocol for embedding charts in chat responses
- Backend selection per-render (Vega-Lite for SVG, ECharts for complex, Chart.js for speed)
"""

import subprocess
import tempfile
from pathlib import Path

from app.core.config import settings
from app.core.logging import logger


class FlintChartBridge:
    """Bridge to the Flint Chart MCP server.

    Flint runs as a Node.js MCP stdio server via `npx -y flint-chart-mcp`.
    This bridge communicates with it via the MCP protocol for chart rendering.

    For the initial integration, we use a simpler approach: call Flint's
    core rendering via subprocess, passing the spec as JSON on stdin.
    As Flint matures (heading toward v1.0), we'll switch to the MCP client
    for persistent connections.
    """

    def __init__(self, tenant_id: str = "default"):
        self.tenant_id = tenant_id
        self._data_root = Path(settings.FLINT_MCP_DATA_ROOTS.split(",")[0].strip())
        self._data_root.mkdir(parents=True, exist_ok=True)

    async def render(
        self,
        spec: dict,
        backend: str = "vegalite",
        output_format: str = "png",
        scale: int = 2,
    ) -> dict:
        """Render a ChartAssemblyInput spec to PNG or SVG.

        Args:
            spec: ChartAssemblyInput specification dict
            backend: One of 'vegalite', 'echarts', 'chartjs'
            output_format: 'png' or 'svg'
            scale: Output scale factor for PNG

        Returns:
            dict with keys: success, format, image_base64/svg, backend, warnings, errors
        """
        logger.info(
            "Rendering chart via Flint",
            backend=backend,
            format=output_format,
            tenant_id=self.tenant_id,
            chart_type=spec.get("chartType", "unknown"),
        )

        # Write data to temp file if inline values exceed threshold
        spec = self._prepare_data(spec)

        try:
            result = await self._call_flint_mcp(spec, backend, output_format, scale)
            result["backend"] = backend
            return result
        except Exception as e:
            logger.error(f"Flint rendering failed: {e}")
            return {
                "success": False,
                "format": output_format,
                "backend": backend,
                "warnings": [],
                "errors": [str(e)],
            }

    def _prepare_data(self, spec: dict) -> dict:
        """If inline data is large, write it to a temp file and use data.url instead.
        This avoids hitting Flint's inline row limits."""
        data = spec.get("data", {})
        values = data.get("values", [])

        if len(values) > 100:  # Threshold for file-based data
            import json

            temp_file = self._data_root / f"genbi_chart_{self.tenant_id}.json"
            temp_file.write_text(json.dumps(values, default=str))
            spec["data"] = {"url": str(temp_file)}
            logger.debug(f"Wrote {len(values)} rows to {temp_file}")

        return spec

    async def _call_flint_mcp(
        self,
        spec: dict,
        backend: str,
        output_format: str,
        scale: int,
    ) -> dict:
        """Call Flint MCP to render a chart.

        This uses the MCP protocol via stdin/stdout. For the initial integration,
        we construct the equivalent tool call directly.

        TODO: Replace with proper MCP client session when Flint's MCP server
        supports persistent connections and HTTP/SSE transport.
        """
        # Validate and compile the spec
        validation = await self._validate_spec(spec)
        if validation.get("errors"):
            return {
                "success": False,
                "format": output_format,
                "warnings": validation.get("warnings", []),
                "errors": validation["errors"],
            }

        # For now, render via Vega-Lite directly using the spec
        # This is a local rendering path that bypasses Flint MCP
        # while Flint is in early v0.1.0 — switch to MCP when it stabilizes
        return await self._render_vegalite_fallback(spec, output_format, scale)

    async def _validate_spec(self, spec: dict) -> dict:
        """Validate a ChartAssemblyInput spec before rendering."""
        errors = []
        warnings = []

        required = ["chartType", "data"]
        for key in required:
            if key not in spec:
                errors.append(f"Missing required field: {key}")

        if "chartType" in spec and spec["chartType"] not in self.SUPPORTED_CHART_TYPES:
            warnings.append(
                f"Unknown chart type: {spec['chartType']} — will attempt best-effort rendering"
            )

        data = spec.get("data", {})
        if "values" in data and len(data["values"]) > 10000:
            errors.append(f"Row count {len(data['values'])} exceeds limit of 10,000")

        if "url" in data:
            url = data["url"]
            if url.startswith(("http://", "https://")):
                errors.append(
                    "Remote data URLs are not supported — use inline values or local files"
                )
            elif not any(url.startswith(str(r)) for r in self._data_root.parents):
                warnings.append(f"Data file {url} is outside approved data roots")

        return {"errors": errors, "warnings": warnings}

    async def _render_vegalite_fallback(self, spec: dict, output_format: str, scale: int) -> dict:
        """Fallback renderer using Vega-Lite directly (no Flint MCP required).
        This is the bootstrapping path — replace with actual MCP calls when
        Flint stabilizes."""
        import base64
        from importlib.util import find_spec

        if find_spec("altair") is None:
            return {
                "success": False,
                "format": output_format,
                "warnings": [],
                "errors": ["altair not installed — install with: uv add altair"],
            }

        data = spec.get("data", {}).get("values", [])
        if not data:
            return {
                "success": False,
                "format": output_format,
                "warnings": [],
                "errors": ["No data provided for chart rendering"],
            }

        encodings = spec.get("encodings", {})
        chart_type = spec.get("chartType", "Bar Chart")
        base_size = spec.get("baseSize", {"width": 600, "height": 400})

        import pandas as pd

        df = pd.DataFrame(data)

        chart = self._build_altair_chart(df, chart_type, encodings, base_size)

        if output_format == "svg":
            svg_str = chart.to_json(format="svg")
            return {
                "success": True,
                "format": "svg",
                "svg": svg_str,
                "warnings": [],
                "errors": [],
            }

        # PNG via Vega-Lite -> SVG -> resvg

        with tempfile.NamedTemporaryFile(suffix=".svg", delete=False) as f:
            f.write(chart.to_json(format="svg").encode())
            svg_path = f.name

        png_path = svg_path.replace(".svg", ".png")
        try:
            subprocess.run(
                ["resvg", svg_path, png_path, "-w", str(base_size["width"] * scale)],
                check=True,
                capture_output=True,
                timeout=30,
            )
            png_data = Path(png_path).read_bytes()
            image_base64 = base64.b64encode(png_data).decode()
            Path(svg_path).unlink(missing_ok=True)
            Path(png_path).unlink(missing_ok=True)
            return {
                "success": True,
                "format": "png",
                "image_base64": image_base64,
                "warnings": [],
                "errors": [],
            }
        except (subprocess.CalledProcessError, FileNotFoundError):
            # resvg not available — return SVG even for PNG requests
            svg_data = Path(svg_path).read_text()
            Path(svg_path).unlink(missing_ok=True)
            return {
                "success": True,
                "format": "svg",
                "svg": svg_data,
                "warnings": ["resvg not installed — returned SVG instead of PNG"],
                "errors": [],
            }

    def _build_altair_chart(self, df, chart_type: str, encodings: dict, base_size: dict):
        """Build an Altair/Vega-Lite chart from a simplified Flint-inspired spec."""
        import altair as alt

        x_field = encodings.get("x", {}).get("field", df.columns[0])
        y_field = encodings.get("y", {}).get("field", df.columns[-1])
        color_field = encodings.get("color", {}).get("field")

        width = base_size.get("width", 600)
        height = base_size.get("height", 400)

        chart_map = {
            "Bar Chart": lambda: (
                alt.Chart(df)
                .mark_bar()
                .encode(
                    x=alt.X(f"{x_field}:N", title=x_field),
                    y=alt.Y(f"{y_field}:Q", title=y_field),
                    color=alt.value("#4C78A8")
                    if not color_field
                    else alt.Color(f"{color_field}:N"),
                )
            ),
            "Line Chart": lambda: (
                alt.Chart(df)
                .mark_line(point=True)
                .encode(
                    x=alt.X(
                        f"{x_field}:T" if "date" in x_field.lower() else f"{x_field}:O",
                        title=x_field,
                    ),
                    y=alt.Y(f"{y_field}:Q", title=y_field),
                    color=alt.Color(f"{color_field}:N") if color_field else alt.Undefined,
                )
            ),
            "Scatter Chart": lambda: (
                alt.Chart(df)
                .mark_circle(size=60)
                .encode(
                    x=alt.X(f"{x_field}:Q", title=x_field),
                    y=alt.Y(f"{y_field}:Q", title=y_field),
                    color=alt.Color(f"{color_field}:N") if color_field else alt.Undefined,
                )
            ),
            "Area Chart": lambda: (
                alt.Chart(df)
                .mark_area(opacity=0.5)
                .encode(
                    x=alt.X(
                        f"{x_field}:T" if "date" in x_field.lower() else f"{x_field}:O",
                        title=x_field,
                    ),
                    y=alt.Y(f"{y_field}:Q", title=y_field),
                )
            ),
            "Pie Chart": lambda: (
                alt.Chart(df)
                .mark_arc()
                .encode(
                    theta=alt.Theta(f"{y_field}:Q"),
                    color=alt.Color(f"{x_field}:N"),
                )
            ),
        }

        builder = chart_map.get(chart_type, chart_map["Bar Chart"])
        chart = builder()
        return chart.properties(width=width, height=height)

    SUPPORTED_CHART_TYPES = {
        "Bar Chart",
        "Stacked Bar Chart",
        "Grouped Bar Chart",
        "Line Chart",
        "Multi-series Line Chart",
        "Scatter Chart",
        "Scatter Plot",
        "Area Chart",
        "Stacked Area Chart",
        "Pie Chart",
        "Donut Chart",
        "Histogram",
        "Box Plot",
        "Heatmap",
    }
