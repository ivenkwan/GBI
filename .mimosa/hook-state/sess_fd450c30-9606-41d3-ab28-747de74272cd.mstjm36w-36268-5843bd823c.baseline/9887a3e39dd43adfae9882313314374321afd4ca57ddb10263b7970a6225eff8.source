// GenBI Cube project — data models live in ./schema/*.yml (10 cubes over the
// seeded analytics tables). ADR 007 documents the pivot from the dbt
// MetricFlow scaffold (which could not run in this repo) to Cube-native
// models as the single source of truth for metric definitions.
//
// Postgres connection comes from the standard CUBEJS_DB_* environment
// variables (see .env.example / scripts/gen-env.sh): Cube connects as the
// read-only `cube_reader` role. Note the analytics tables are RLS-enforced
// (Phase 8b), so data queries need a per-tenant GUC — that driver work is
// deliberately deferred to Phase 10 with /metrics/query. The /meta endpoint
// (metric metadata, used by CubeClient and the NL2SQL agent) is unaffected.

module.exports = {
  apiSecret: process.env.CUBEJS_API_SECRET,
  devMode: process.env.CUBEJS_DEV_MODE === "true",
  // Phase 10 hook: per-tenant compilation context once data queries land.
  // contextToOrchestratorId: ({ securityContext }) => securityContext.tenantId,
};
