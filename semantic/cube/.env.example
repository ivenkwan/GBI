# Driver type for Cube built-in resolver (refresh scheduler runs without a
# securityContext, where the per-tenant driverFactory does not apply).
CUBEJS_DB_TYPE=postgres
# Cube.dev — standard CUBEJS_DB_* driver env (Cube connects as the read-only
# cube_reader role created by infra/postgres/init.sql). Hosts here are for
# host-based dev; scripts/gen-env.sh rewrites them to compose service names.
CUBEJS_DB_HOST=localhost
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=genbi
CUBEJS_DB_USER=cube_reader
CUBEJS_DB_PASS=changeme_cube_reader

CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=change-me-in-production
CUBEJS_WEB_SOCKETS=true
