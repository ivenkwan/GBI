"""Chart hallucination detection and correction.

Deterministic validation of LLM-generated chart specifications against
the underlying data. Catches common LLM hallucination modes:

1. **Field hallucination**: spec references columns that don't exist in data
2. **Type mismatch**: chart type requires encodings that the data can't satisfy
   (e.g., Pie Chart with quantitative x-axis, Line Chart with no temporal data)
3. **Data range hallucination**: axis values imply impossibilities
   (e.g., negative revenue, dates in the future, percentages > 100%)
4. **Aggregate mismatch**: chart implies aggregation that doesn't match data
   (e.g., bar chart shows 5 bars but data has 3 categories)
5. **Empty/null data**: chart spec doesn't handle missing values
6. **Structurally invalid**: malformed Vega-Lite spec that would fail to render

Correction strategies:
    - Field mismatch → rewrite encoding field names from available columns
    - Type mismatch → downgrade to a compatible chart type
    - Range issues → adjust axis bounds to data min/max
    - Structural issues → rebuild with safe defaults

Design principle: The validator should NEVER reject a chart outright unless
the data is completely unplottable. Prefer correction over rejection.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum

from app.core.logging import logger

# ---------------------------------------------------------------------------
# Chart type constraints
# ---------------------------------------------------------------------------


class ChartType(str, Enum):
    """Flint-supported chart types with encoding requirements."""

    BAR = "Bar Chart"
    LINE = "Line Chart"
    PIE = "Pie Chart"
    SCATTER = "Scatter Chart"
    AREA = "Area Chart"
    HEATMAP = "Heatmap"
    TABLE = "Table"


# Each chart type requires certain semantic types for x/y encodings
CHART_TYPE_REQUIREMENTS: dict[str, dict] = {
    "Bar Chart": {
        "x_needs": ["Category", "Temporal"],
        "y_needs": ["Quantity"],
        "x_needs_single": True,  # one category per bar
        "max_categories": 30,    # readability limit
    },
    "Line Chart": {
        "x_needs": ["Temporal", "Category"],
        "y_needs": ["Quantity"],
        "prefers_temporal_x": True,
    },
    "Pie Chart": {
        "x_needs": ["Category"],
        "y_needs": ["Quantity"],
        "max_categories": 10,     # slices become unreadable
        "x_needs_single": True,
    },
    "Scatter Chart": {
        "x_needs": ["Quantity"],
        "y_needs": ["Quantity"],
        "min_points": 5,
    },
    "Area Chart": {
        "x_needs": ["Temporal", "Category"],
        "y_needs": ["Quantity"],
    },
    "Heatmap": {
        "x_needs": ["Category"],
        "y_needs": ["Category"],
        "color_needs": ["Quantity"],
    },
    "Table": {
        # Tables accept anything
    },
}


# ---------------------------------------------------------------------------
# Data types
# ---------------------------------------------------------------------------


@dataclass
class ValidationIssue:
    """A single hallucination finding."""

    code: str
    severity: str  # "error", "warning", "info"
    field: str | None = None
    message: str = ""
    fix_applied: str | None = None


@dataclass
class ChartValidationResult:
    """Full validation output for a chart spec."""

    is_valid: bool
    issues: list[ValidationIssue] = field(default_factory=list)
    corrected_spec: dict | None = None
    suggested_chart_type: str | None = None

    @property
    def has_errors(self) -> bool:
        return any(i.severity == "error" for i in self.issues)

    @property
    def warnings(self) -> list[str]:
        return [i.message for i in self.issues if i.severity == "warning"]

    @property
    def fix_summary(self) -> list[str]:
        return [
            f"{i.code}: {i.fix_applied}"
            for i in self.issues
            if i.fix_applied
        ]


# ---------------------------------------------------------------------------
# Data inference
# ---------------------------------------------------------------------------


def infer_column_types(data: list[dict]) -> dict[str, str]:
    """Infer semantic types for each column in the dataset.

    Returns mapping of column_name → "Category" | "Quantity" | "Temporal"
    """
    if not data:
        return {}

    types: dict[str, str] = {}
    for col in data[0].keys():
        values = [row.get(col) for row in data if row.get(col) is not None]
        if not values:
            types[col] = "Category"
            continue

        sample = values[:20]

        # Numeric check
        all_numeric = all(isinstance(v, (int, float)) for v in sample)
        if all_numeric:
            # Could be a year (Temporal) or a regular number (Quantity)
            if all(1900 <= v <= 2100 for v in sample if isinstance(v, (int, float))):
                types[col] = "Temporal"
            else:
                types[col] = "Quantity"
            continue

        # String check
        all_string = all(isinstance(v, str) for v in sample)
        if all_string:
            # Check for date patterns
            import re
            date_pat = re.compile(r"\d{4}-\d{2}-\d{2}")
            if all(date_pat.match(str(v)) for v in sample):
                types[col] = "Temporal"
            else:
                types[col] = "Category"
            continue

        types[col] = "Category"

    return types


def compute_column_stats(data: list[dict]) -> dict[str, dict]:
    """Compute basic statistics for each column."""
    stats: dict[str, dict] = {}

    for col in data[0].keys() if data else []:
        values = [row.get(col) for row in data if row.get(col) is not None]
        col_stats = {
            "count": len(values),
            "null_count": len(data) - len(values),
            "distinct_count": len(set(str(v) for v in values)),
        }

        numeric_vals = [v for v in values if isinstance(v, (int, float))]
        if numeric_vals:
            col_stats["min"] = min(numeric_vals)
            col_stats["max"] = max(numeric_vals)
            col_stats["mean"] = sum(numeric_vals) / len(numeric_vals)
            col_stats["sum"] = sum(numeric_vals)
            col_stats["is_negative"] = col_stats["min"] < 0

        stats[col] = col_stats

    return stats


# ---------------------------------------------------------------------------
# Validators
# ---------------------------------------------------------------------------


def validate_field_existence(
    spec: dict, data: list[dict]
) -> list[ValidationIssue]:
    """Check that all encoding fields exist in the data columns."""
    if not data:
        return [ValidationIssue(
            code="EMPTY_DATA",
            severity="error",
            message="No data to generate chart from",
        )]

    issues: list[ValidationIssue] = []
    available_columns = set(data[0].keys())

    encodings = spec.get("encodings", {})
    for channel, encoding in encodings.items():
        if not isinstance(encoding, dict):
            continue
        field = encoding.get("field", "")
        if field and field not in available_columns:
            # Try to find a similar column to fix
            fixed_field = _find_best_match(field, available_columns)
            issues.append(ValidationIssue(
                code="FIELD_NOT_FOUND",
                severity="error",
                field=field,
                message=f"Chart references column '{field}' which doesn't exist in data",
                fix_applied=f"Corrected to '{fixed_field}'" if fixed_field else None,
            ))
            if fixed_field:
                encoding["field"] = fixed_field

    return issues


def validate_chart_type_compatibility(
    spec: dict, data: list[dict], column_types: dict[str, str]
) -> list[ValidationIssue]:
    """Check that the chart type is compatible with the data structure."""
    if not data:
        return []

    chart_type = spec.get("chartType", "Bar Chart")
    issues: list[ValidationIssue] = []

    reqs = CHART_TYPE_REQUIREMENTS.get(chart_type, {})
    if not reqs:
        return []  # Unknown chart type — pass through

    encodings = spec.get("encodings", {})
    x_field = encodings.get("x", {}).get("field", "")
    y_field = encodings.get("y", {}).get("field", "")

    # Check x-axis
    if "x_needs" in reqs and x_field:
        x_type = column_types.get(x_field, "Category")
        if x_type not in reqs["x_needs"]:
            issues.append(ValidationIssue(
                code="X_AXIS_TYPE_MISMATCH",
                severity="error",
                field=x_field,
                message=(
                    f"Chart type '{chart_type}' needs x-axis of type "
                    f"{reqs['x_needs']} but column '{x_field}' is '{x_type}'"
                ),
            ))

    # Check y-axis
    if "y_needs" in reqs and y_field:
        y_type = column_types.get(y_field, "Category")
        if y_type not in reqs["y_needs"]:
            issues.append(ValidationIssue(
                code="Y_AXIS_TYPE_MISMATCH",
                severity="error",
                field=y_field,
                message=(
                    f"Chart type '{chart_type}' needs y-axis of type "
                    f"{reqs['y_needs']} but column '{y_field}' is '{y_type}'"
                ),
            ))

    # Pie chart: check category count
    if chart_type == "Pie Chart":
        max_cats = reqs.get("max_categories", 10)
        distinct = len(set(str(row.get(x_field)) for row in data if x_field))
        if distinct > max_cats:
            issues.append(ValidationIssue(
                code="PIE_TOO_MANY_SLICES",
                severity="warning",
                field=x_field,
                message=(
                    f"Pie chart has {distinct} categories (max recommended: {max_cats}). "
                    f"Consider using a Bar Chart instead."
                ),
            ))

    # Scatter: check point count
    if chart_type == "Scatter Chart":
        min_points = reqs.get("min_points", 5)
        non_null = sum(
            1 for r in data
            if r.get(x_field) is not None and r.get(y_field) is not None
        )
        if non_null < min_points:
            issues.append(ValidationIssue(
                code="SCATTER_TOO_FEW_POINTS",
                severity="error",
                message=(
                    f"Scatter chart has {non_null} valid points "
                    f"(minimum recommended: {min_points})"
                ),
            ))

    # Line chart: prefer temporal x
    if chart_type == "Line Chart" and reqs.get("prefers_temporal_x") and x_field:
        x_type = column_types.get(x_field, "Category")
        if x_type != "Temporal":
            issues.append(ValidationIssue(
                code="LINE_NON_TEMPORAL_X",
                severity="warning",
                field=x_field,
                message=(
                    f"Line Chart x-axis '{x_field}' is '{x_type}', not Temporal. "
                    f"Line order may appear random."
                ),
            ))

    return issues


def validate_data_ranges(
    spec: dict, data: list[dict], column_stats: dict[str, dict]
) -> list[ValidationIssue]:
    """Check that chart axis values are within reasonable bounds."""
    if not data:
        return []

    issues: list[ValidationIssue] = []

    encodings = spec.get("encodings", {})
    for channel in ("x", "y"):
        encoding = encodings.get(channel, {})
        if not isinstance(encoding, dict):
            continue
        field = encoding.get("field", "")
        if not field or field not in column_stats:
            continue

        stats = column_stats[field]

        # Check for impossible values in Quantity fields
        if "min" in stats and "max" in stats:
            col_min, col_max = stats["min"], stats["max"]

            # Revenue/cost should not be negative in business contexts
            field_lower = field.lower()
            if any(keyword in field_lower for keyword in ("revenue", "amount", "price", "sales", "value")):
                if col_min < 0:
                    issues.append(ValidationIssue(
                        code="NEGATIVE_VALUE",
                        severity="warning",
                        field=field,
                        message=f"Column '{field}' contains negative values (min={col_min}) but appears to be a business metric",
                    ))

            # Check spec axis bounds against data
            scale = encoding.get("scale", {})
            domain_min = scale.get("domainMin")
            domain_max = scale.get("domainMax")

            if domain_min is not None and domain_min < col_min:
                issues.append(ValidationIssue(
                    code="AXIS_BOUND_TOO_LOW",
                    severity="warning",
                    field=field,
                    message=f"Axis minimum {domain_min} is below data minimum {col_min}",
                    fix_applied=f"Axis min adjusted to {col_min}",
                ))
                scale["domainMin"] = col_min

            if domain_max is not None and domain_max > col_max * 1.5 and col_max > 0:
                issues.append(ValidationIssue(
                    code="AXIS_BOUND_TOO_HIGH",
                    severity="warning",
                    field=field,
                    message=f"Axis maximum {domain_max} far exceeds data range (max={col_max})",
                ))

    return issues


def validate_spec_structure(spec: dict) -> list[ValidationIssue]:
    """Check that the chart spec has all required fields for rendering."""
    issues: list[ValidationIssue] = []

    required_keys = ("chartType", "data")
    for key in required_keys:
        if key not in spec:
            issues.append(ValidationIssue(
                code="MISSING_REQUIRED_KEY",
                severity="error",
                field=key,
                message=f"Chart spec is missing required key '{key}'",
            ))

    # Check data presence
    data_block = spec.get("data", {})
    if isinstance(data_block, dict) and not data_block.get("values"):
        issues.append(ValidationIssue(
            code="EMPTY_DATA_VALUES",
            severity="error",
            message="Chart data.values is empty — nothing to render",
        ))

    # Check encodings have field names
    encodings = spec.get("encodings", {})
    if not encodings:
        issues.append(ValidationIssue(
            code="NO_ENCODINGS",
            severity="warning",
            message="Chart has no encodings — will render as empty canvas",
        ))

    return issues


def validate_null_handling(
    spec: dict, data: list[dict]
) -> list[ValidationIssue]:
    """Check that the chart handles null/missing values appropriately."""
    if not data:
        return []

    issues: list[ValidationIssue] = []

    encodings = spec.get("encodings", {})
    for channel, encoding in encodings.items():
        if not isinstance(encoding, dict):
            continue
        field = encoding.get("field", "")
        if not field:
            continue

        null_count = sum(1 for row in data if row.get(field) is None)
        if null_count > 0:
            null_pct = (null_count / len(data)) * 100
            if null_pct > 20:
                issues.append(ValidationIssue(
                    code="HIGH_NULL_RATIO",
                    severity="warning",
                    field=field,
                    message=(
                        f"Column '{field}' has {null_count} null values "
                        f"({null_pct:.0f}% of data). Chart may be misleading."
                    ),
                ))

    return issues


def validate_data_size(spec: dict, data: list[dict]) -> list[ValidationIssue]:
    """Check that the data size is appropriate for the chart type."""
    issues: list[ValidationIssue] = []

    chart_type = spec.get("chartType", "Bar Chart")
    row_count = len(data)

    if row_count > 10000 and chart_type not in ("Table", "Heatmap"):
        issues.append(ValidationIssue(
            code="DATA_TOO_LARGE",
            severity="warning",
            message=(
                f"Chart data has {row_count} rows. Rendering performance "
                f"may degrade. Consider limiting or aggregating."
            ),
        ))

    if row_count == 0:
        issues.append(ValidationIssue(
            code="NO_DATA",
            severity="error",
            message="Data is empty — cannot generate chart",
        ))

    return issues


# ---------------------------------------------------------------------------
# Correction engine
# ---------------------------------------------------------------------------


def suggest_chart_type_fix(
    chart_type: str, column_types: dict[str, str],
    data: list[dict], has_errors: bool,
) -> str | None:
    """If the requested chart type has incompatibilities, suggest a fallback."""
    if not has_errors:
        return None

    categories = [k for k, v in column_types.items() if v == "Category"]
    quantities = [k for k, v in column_types.items() if v == "Quantity"]
    temporals = [k for k, v in column_types.items() if v == "Temporal"]

    # Fallback chain
    if chart_type == "Pie Chart" and len(data) > 10:
        return "Bar Chart"

    if chart_type == "Scatter Chart" and len(quantities) < 2:
        if temporals and quantities:
            return "Line Chart"
        if categories and quantities:
            return "Bar Chart"

    if chart_type == "Line Chart" and not temporals:
        if categories and quantities:
            return "Bar Chart"

    if chart_type == "Heatmap" and not quantities and categories:
        return "Table"

    # Universal fallback
    if not categories and not quantities:
        return "Table"

    return "Bar Chart"


# ---------------------------------------------------------------------------
# Main validator
# ---------------------------------------------------------------------------


def validate_chart_spec(
    spec: dict,
    data: list[dict],
    chart_type_override: str | None = None,
    auto_correct: bool = True,
) -> ChartValidationResult:
    """Validate a chart spec against data and correct hallucinations.

    Args:
        spec: The generated chart specification (ChartAssemblyInput format)
        data: The underlying SQL result data
        chart_type_override: Force a specific chart type (bypasses LLM's choice)
        auto_correct: If True, attempt to fix issues rather than just flagging them

    Returns:
        ChartValidationResult with issues, warnings, and optionally corrected spec
    """
    all_issues: list[ValidationIssue] = []

    if not data:
        return ChartValidationResult(
            is_valid=False,
            issues=[ValidationIssue(
                code="NO_DATA",
                severity="error",
                message="No data provided for chart validation",
            )],
            corrected_spec=spec,
        )

    # Override chart type if requested
    if chart_type_override:
        original_type = spec.get("chartType", "")
        spec["chartType"] = chart_type_override
        if original_type != chart_type_override:
            all_issues.append(ValidationIssue(
                code="CHART_TYPE_OVERRIDDEN",
                severity="info",
                field="chartType",
                message=f"Chart type overridden from '{original_type}' to '{chart_type_override}'",
            ))
            chart_type = chart_type_override
        else:
            chart_type = original_type
    else:
        chart_type = spec.get("chartType", "Bar Chart")

    # Compute column metadata
    column_types = infer_column_types(data)
    column_stats = compute_column_stats(data)

    # Run all validators
    all_issues.extend(validate_spec_structure(spec))
    all_issues.extend(validate_data_size(spec, data))

    if spec.get("encodings"):
        all_issues.extend(validate_field_existence(spec, data))
        all_issues.extend(validate_chart_type_compatibility(spec, data, column_types))
        all_issues.extend(validate_data_ranges(spec, data, column_stats))
        all_issues.extend(validate_null_handling(spec, data))

    # Determine validity
    has_errors = any(i.severity == "error" for i in all_issues)
    is_valid = not has_errors

    # Attempt correction if auto_correct is enabled and there are errors
    corrected_spec = spec
    suggested_type = None

    if not is_valid and auto_correct:
        # Re-validate to apply in-place fixes (fields may have been corrected)
        if any(i.code == "FIELD_NOT_FOUND" for i in all_issues):
            all_issues.extend(validate_field_existence(spec, data))

        # Suggest chart type correction
        suggested_type = suggest_chart_type_fix(
            chart_type, column_types, data, has_errors=True,
        )
        if suggested_type and suggested_type != chart_type:
            corrected_spec = dict(spec)  # shallow copy
            corrected_spec["chartType"] = suggested_type
            all_issues.append(ValidationIssue(
                code="CHART_TYPE_CORRECTED",
                severity="warning",
                field="chartType",
                message=f"Chart type corrected from '{chart_type}' to '{suggested_type}' due to data incompatibility",
                fix_applied=f"Changed to {suggested_type}",
            ))

        # Re-check validity after corrections
        has_errors_after = any(
            i.severity == "error" and i.code not in ("FIELD_NOT_FOUND",)
            for i in all_issues
        )
        is_valid = not has_errors_after

    # Log validation summary
    error_codes = [i.code for i in all_issues if i.severity == "error"]
    warning_codes = [i.code for i in all_issues if i.severity == "warning"]
    logger.info(
        "Chart validation complete",
        is_valid=is_valid,
        chart_type=chart_type,
        errors=error_codes,
        warnings=warning_codes,
        corrections=len([i for i in all_issues if i.fix_applied]),
    )

    return ChartValidationResult(
        is_valid=is_valid,
        issues=all_issues,
        corrected_spec=corrected_spec if corrected_spec is not spec else None,
        suggested_chart_type=suggested_type,
    )


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _find_best_match(field: str, available: set[str]) -> str | None:
    """Find the best matching column name using fuzzy matching."""
    field_lower = field.lower().strip()

    # Exact match (case-insensitive)
    for col in available:
        if col.lower() == field_lower:
            return col

    # Contains match
    for col in available:
        if field_lower in col.lower() or col.lower() in field_lower:
            return col

    # Levenshtein-like: find closest by shared prefix length
    best = None
    best_score = 0
    for col in available:
        score = _common_prefix_len(field_lower, col.lower())
        if score > best_score:
            best_score = score
            best = col

    if best_score >= 3 and best:
        return best

    return None


def _common_prefix_len(a: str, b: str) -> int:
    """Length of common prefix between two strings."""
    n = 0
    for ca, cb in zip(a, b):
        if ca == cb:
            n += 1
        else:
            break
    return n
